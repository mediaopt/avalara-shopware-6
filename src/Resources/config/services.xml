<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="MoptAvalara6\Controller\Api\ApiTestController" public="true">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="MoptAvalara6\Subscriber\CheckoutSubscriber">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
            <argument type="service" id="category.repository" />
            <tag name="kernel.event_subscriber" priority="-5100"/>
        </service>

        <service id="MoptAvalara6\Subscriber\AddressSubscriber">
            <argument type="service" id="router" />
            <tag name="kernel.event_subscriber" priority="-5100"/>
        </service>

        <service id="MoptAvalara6\Subscriber\OrderChangesSubscriber">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
            <argument type="service" id="order.repository" />
            <tag name="kernel.event_subscriber" priority="-5100"/>
        </service>

        <service id="MoptAvalara6\Core\Checkout\Cart\OverwritePriceProcessor">
            <argument type="service" id="Shopware\Core\Checkout\Cart\Price\QuantityPriceCalculator"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
            <argument type="service" id="category.repository" />
            <tag name="shopware.cart.processor" priority="-5200"/>
        </service>

        <service id="MoptAvalara6\Controller\AddressValidationController" public="true">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="MoptAvalara6\Core\Checkout\Cart\CartValidator">
            <argument type="service" id="request_stack" />
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
            <tag name="shopware.cart.validator"/>
        </service>

        <service id="MoptAvalara6\Controller\SupportForm\SupportFormController" public="true">
            <argument type="service" id="Shopware\Core\Framework\Api\Controller\UserController" />
            <argument type="service" id="Shopware\Core\Framework\Api\Response\Type\Api\JsonType"/>
            <argument type="service" id="Shopware\Core\Content\Mail\Service\MailService"/>
            <argument type="service" id="media.repository"/>
            <argument type="service" id="Shopware\Core\Content\Media\MediaService" />
            <argument type="service" id="Shopware\Core\Content\Media\File\FileSaver" />
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>
        <service id="MoptAvalara6\Subscriber\SupportFormSubscriber">
            <tag name="kernel.event_subscriber" priority="-5100"/>
        </service>
        <service id="MoptAvalara6\Controller\OrderStates\OrderStatesController" public="true">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="MoptAvalara6\Controller\CompanyCode\CompanyCodeController" public="true">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="MoptAvalara6\Controller\TaxCode\TaxCodeController" public="true">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="MoptAvalara6\Controller\ExemptionCode\ExemptionCodeController" public="true">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService" />
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>
    </services>
</container>
