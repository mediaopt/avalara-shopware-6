<div class="avalara-exemption-code-select">
    <sw-select-field
        v-model:value="localValue"
        :label="label || $tc('avalara-exemption-code-select.title')"
        :disabled="disabled || isLoading"
        @update:value="onSelect"
    >
        <option value="" disabled>{{ $tc('avalara-exemption-code-select.placeholder') }}</option>
        <option
            v-for="option in exemptionCodeOptions"
            :key="option.value"
            :value="option.value"
        >
            {{ option.label }}
        </option>
    </sw-select-field>
    <sw-button
        size="small"
        :disabled="isLoading"
        :is-loading="isLoading"
        @click="onRefresh"
    >
        {{ $tc('avalara-exemption-code-select.refresh') }}
    </sw-button>
</div>