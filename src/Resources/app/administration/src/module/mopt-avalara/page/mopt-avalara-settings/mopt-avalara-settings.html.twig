{% block mopt_avalara_settings_index %}
    <sw-page class="mopt-avalara-settings-page">

        {% block mopt_avalara_settings_header %}
            <template #header>
                <h2>
                    {{ $tc('mopt-avalara.settings.title') }}
                </h2>
            </template>
        {% endblock %}

        {% block mopt_avalara_settings_smart_bar_actions %}
            <template #smart-bar-actions>
                <sw-button variant="primary" @click="onSave">
                    {{ $tc('mopt-avalara.settings.saveButton') }}
                </sw-button>
            </template>
        {% endblock %}

        {% block mopt_avalara_settings_content %}
            <template #content>
                <sw-card-view>

                    <sw-system-config
                            ref="systemConfig"
                            domain="MoptAvalara6.config"
                            sales-channel-switchable
                            :sales-channel-id="salesChannelId"
                    >
                        <template #afterElements="{ config, index }">
                            <mopt-avalara-config-watcher
                                    v-if="index == 1"
                                    :config="config"
                                    @config-changed="onConfigChanged"
                            />
                        </template>
                    </sw-system-config>

                    <sw-card :title="'Order statuses'">
                        <sw-select-field
                                v-model="cancelStatusId"
                                :options="selectOptions"
                                :label="$tc('avalara-order-states.state-cancel')"
                                @update:model-value="setCancelStatusId">
                        </sw-select-field>

                        <sw-select-field
                                v-model="refundStatusId"
                                :options="selectOptions"
                                :label="$tc('avalara-order-states.state-refund')"
                                @update:model-value="setRefundStatusId">
                        </sw-select-field>
                    </sw-card>
                </sw-card-view>
            </template>
        {% endblock %}

    </sw-page>
{% endblock %}