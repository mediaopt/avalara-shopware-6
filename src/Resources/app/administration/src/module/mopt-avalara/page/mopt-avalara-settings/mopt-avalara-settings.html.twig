{% block mopt_avalara_settings_index %}
    <sw-page class="mopt-avalara-settings-page">

        {% block mopt_avalara_settings_header %}
            <template #header>
                <h2>
                    {{ $tc('mopt-avalara-settings.general.mainMenuItemGeneral') }}
                    <sw-icon name="regular-chevron-right-xs" small></sw-icon>
                    {{ $tc('mopt-avalara-settings.settings.title') }}
                </h2>
            </template>
        {% endblock %}

        {% block mopt_avalara_settings_smart_bar_actions %}
            <template #smart-bar-actions>
                <sw-button variant="primary" @click="onSaveSettings">
                    {{ $tc('mopt-avalara-settings.settings.saveButton') }}
                </sw-button>
            </template>
        {% endblock %}

        {% block mopt_avalara_settings_content %}
            <template #content>
                <sw-card-view>
                    <sw-card title="Card-1" large>
                        Lorem ipsum dolor sit amet
                    </sw-card>

                    <sw-card title="Card-2" large>
                        <avalara-order-states></avalara-order-states>
                    </sw-card>
                </sw-card-view>
            </template>
        {% endblock %}

    </sw-page>
{% endblock %}
